[core]
    pager = delta
[interactive]
    diffFilter = delta --color-only
[delta]
    navigate = true
    light = false
    conflictstyle = diff3
    side-by-side = true
    hyperlinks = true
[merge]
    conflictstyle = diff3
[diff]
    colorMoved = plain
    algorithm = histogram
    renames = true
[push]
    autoSetupRemote = true
[pull]
    rebase = true
[user]
    email = 20971850+KaBankz@users.noreply.github.com
    name = KaBankz
    signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIFSqVKFpm/W3sSz76XdzuFjToW3TDRztVNz4cGb8AfHs
    # signingkey = 9A41B15FF6B4DEA2
[commit]
    gpgsign = true
[init]
    defaultBranch = master
[gpg]
    format = ssh
    # program = gpg
[gpg "ssh"]
    program = "/Applications/1Password.app/Contents/MacOS/op-ssh-sign"
[rerere]
    enabled = true
[column]
    ui = auto
[branch]
    sort = -committerdate
[tag]
    sort = version:refname
[help]
    autocorrect = prompt
[credential "https://github.com"]
    helper =
    helper = !gh auth git-credential
[credential "https://gist.github.com"]
    helper =
    helper = !gh auth git-credential
