#!/usr/bin/env bash

# Parse our own flags, forward the rest to `brew bundle dump`
commit=1
dump_args=()
for arg in "$@"; do
  case "$arg" in
    --no-commit) commit=0 ;;
    *) dump_args+=("$arg") ;;
  esac
done

# Make a Brewfile backup of all installed packages
brew bundle dump --force --formula --casks --taps --mas --no-describe --file ~/.dotfiles/pkgs/Brewfile "${dump_args[@]}"

if (( commit )); then
  # Commit only the Brewfile, ignoring any other staged changes in the repo
  git -C ~/.dotfiles commit -m "chore(pkgs): update Brewfile" -- pkgs/Brewfile
fi
