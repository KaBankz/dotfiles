#!/usr/bin/env bash

SUPPORTED_TERMINALS=("iTerm.app" "ghostty")

if [ -n "$TMUX" ]; then
  exit 0
fi

# Only continue if the current terminal is in the list of supported terminals
if [[ ! ${SUPPORTED_TERMINALS[*]} =~ ${TERM_PROGRAM} ]]; then
  exit 0
fi

if ! command -v tmux >/dev/null 2>&1; then
  echo "tmux is not installed" >&2
  exit 1
fi

if ! tmux has-session -t main 2>/dev/null; then
  exec tmux new-session -s main
else
  exec tmux attach-session -t main
fi
