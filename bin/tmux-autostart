#!/usr/bin/env bash

SUPPORTED_TERMINALS=("ghostty")

if [ -n "$TMUX" ] || [ -n "$ZELLIJ" ]; then
  exit 0
fi

if [[ ! ${SUPPORTED_TERMINALS[*]} =~ ${TERM_PROGRAM} ]]; then
  exit 0
fi

if ! command -v tmux >/dev/null 2>&1; then
  echo "tmux is not installed" >&2
  exit 1
fi

exec tmux new-session -As main
